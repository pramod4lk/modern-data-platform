{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lcr-monthly.v1",
  "title": "LCR monthly return - one row",
  "type": "object",
  "required": ["institution_id", "reporting_period", "line_code", "currency", "amount"],
  "additionalProperties": false,
  "properties": {
    "institution_id":   { "type": "string", "pattern": "^FI[0-9]{3}$" },
    "reporting_period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "line_code":        { "type": "string", "enum": ["HQLA_L1", "HQLA_L2A", "HQLA_L2B", "OUT_RETAIL", "OUT_WHOLESALE", "OUT_OTHER", "IN_TOTAL"] },
    "currency":         { "type": "string", "enum": ["MYR", "USD", "SGD", "EUR", "GBP", "JPY", "CNY"] },
    "amount":           { "type": "number", "minimum": 0 }
  }
}
