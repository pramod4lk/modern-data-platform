# Example SparkApplication (rename to .yaml to let Argo CD apply it, or kubectl apply it by hand).
# Image is built from images/spark/Dockerfile and pushed to a registry the cluster can reach.
apiVersion: sparkoperator.k8s.io/v1beta2
kind: SparkApplication
metadata:
  name: iceberg-smoke-test
  namespace: lakehouse
spec:
  type: Python
  mode: cluster
  image: <registry>/poc-spark:0.1.0
  imagePullPolicy: IfNotPresent
  mainApplicationFile: local:///opt/poc/pipelines/spark/smoke_test.py
  sparkVersion: "3.5.6"
  restartPolicy: { type: Never }
  driver:
    cores: 1
    memory: 1g
    serviceAccount: spark-operator-spark
    nodeSelector: { poc/role: compute }
    envFrom:
      - secretRef: { name: s3-credentials }
      - secretRef: { name: polaris-engine }
  executor:
    instances: 2
    cores: 1
    memory: 1500m
    nodeSelector: { poc/role: compute }
    envFrom:
      - secretRef: { name: s3-credentials }
      - secretRef: { name: polaris-engine }
